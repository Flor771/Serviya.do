; PLATE RUSH - Godot 4
; The Dominican Street Game

config_version=5

[application]
config/name="PLATE RUSH"
config/description="The Dominican Street Game"
run/main_scene="res://scenes/Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
bat={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}
return={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194319)]
}
throw_ball={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
